{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node18",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/db/connection.ts"],
  "exclude": ["node_modules", "dist", "src/db/migrations", "src/db/seeders"]
}